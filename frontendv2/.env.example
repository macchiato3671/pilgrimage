# Spring Boot backend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Kakao Developers > 앱 > 플랫폼 키 > JavaScript 키
# 실행 도메인(http://localhost:5173 등)을 JavaScript SDK 도메인에 등록하세요.
VITE_KAKAO_MAP_APP_KEY=

# 로그인 화면의 "테스트 계정 채우기" 버튼에만 사용됩니다.
VITE_TEST_EMAIL=member@example.com
VITE_TEST_PASSWORD=Password123!

# 화면 번역용 GMS API 키입니다. 프론트 번들에는 포함하지 않고 백엔드가 읽습니다.
GMS_KEY=
GMS_MODEL=gpt-4o-mini
GMS_CHAT_COMPLETIONS_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions
