# Copy this file to .env and fill in environment-specific values.

# Local MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/moonbackdb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=moonback
SPRING_DATASOURCE_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# JWT (use a random value of at least 32 bytes outside local development)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=5000000
JWT_REFRESH_TOKEN_EXPIRATION=20160

# S3 storage
AWS_REGION=ap-northeast-2
S3_BUCKET=your-bucket
S3_PUBLIC_BASE_URL=
STORAGE_PRESIGNED_URL_EXPIRATION=10m

# Batch-only external services
TMDB_READ_TOKEN=your-tmdb-read-token
KAKAO_REST_API_KEY=your-kakao-rest-api-key
CWEBP_PATH=cwebp
GIF2WEBP_PATH=gif2webp
IMAGEMAGICK_PATH=magick
IMAGE_TEMP_DIR=/tmp/pilgrimage-ingest

# AWS access keys are intentionally omitted.
# Use the AWS SDK default credential chain (AWS CLI profile, IAM role, or
# environment variables supplied outside this file).
