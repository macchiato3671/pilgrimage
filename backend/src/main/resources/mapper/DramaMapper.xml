<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.moonback.pilgrimage.model.mapper.DramaMapper">
	
	<select id="existsByDramaId" resultType="boolean">
		SELECT EXISTS (
			SELECT 1
			FROM Drama
			WHERE drama_id = #{dramaId}
		)
	</select>
</mapper>