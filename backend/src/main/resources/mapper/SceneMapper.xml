<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.pilgrimage.model.mapper.SceneMapper">
	<select id="selectSceneImagesBySceneIds"
        resultType="com.ssafy.pilgrimage.model.dto.SceneImageRowDto">
	    SELECT
	        scene_id AS sceneId,
	        img_id AS imgId,
	        url AS url
	    FROM SceneImg
	    WHERE scene_id IN
	    <foreach collection="sceneIds" item="sceneId" open="(" separator="," close=")">
	        #{sceneId}
	    </foreach>
	    ORDER BY scene_id ASC, img_id ASC
	</select>
</mapper>