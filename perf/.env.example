# Copy to perf/.env when overriding the defaults.
# The Harness should assign a unique Compose project name per experiment.

PERF_HTTP_PORT=80
PERF_BACKEND_PORT=8080
PERF_MYSQL_PORT=3306
PERF_PROMETHEUS_PORT=9090
PERF_TEMPO_PORT=3200
PERF_GRAFANA_PORT=3000

PERF_MYSQL_USER=moonback
PERF_MYSQL_PASSWORD=moonback
PERF_MYSQL_ROOT_PASSWORD=root
PERF_MYSQL_MAX_CONNECTIONS=200
PERF_TZ=Asia/Seoul

PERF_JWT_SECRET=local-performance-harness-secret-change-me
PERF_JWT_ACCESS_TOKEN_EXPIRATION=5000000
PERF_JWT_REFRESH_TOKEN_EXPIRATION=20160

PERF_AWS_REGION=ap-northeast-2
PERF_S3_BUCKET=performance-placeholder
PERF_S3_PUBLIC_BASE_URL=
PERF_STORAGE_PRESIGNED_URL_EXPIRATION=10m

PERF_VITE_API_BASE_URL=/api/v1
PERF_VITE_KAKAO_MAP_APP_KEY=

PERF_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC
PERF_HIKARI_MAXIMUM_POOL_SIZE=20
PERF_HIKARI_MINIMUM_IDLE=5
PERF_HIKARI_CONNECTION_TIMEOUT=30000
PERF_HIKARI_IDLE_TIMEOUT=600000
PERF_HIKARI_MAX_LIFETIME=1800000

PERF_MYSQL_CPUS=2.0
PERF_MYSQL_MEMORY=2g
PERF_BACKEND_CPUS=2.0
PERF_BACKEND_MEMORY=2g
PERF_FRONTEND_CPUS=1.0
PERF_FRONTEND_MEMORY=512m
PERF_MYSQL_EXPORTER_CPUS=0.25
PERF_MYSQL_EXPORTER_MEMORY=256m
PERF_PROMETHEUS_CPUS=1.0
PERF_PROMETHEUS_MEMORY=1g
PERF_TEMPO_CPUS=1.0
PERF_TEMPO_MEMORY=1g
PERF_GRAFANA_CPUS=1.0
PERF_GRAFANA_MEMORY=1g

PERF_GRAFANA_ADMIN_USER=admin
PERF_GRAFANA_ADMIN_PASSWORD=admin
